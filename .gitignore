# Al-Nour School Management Platform - .gitignore

# ===================================
# FRONTEND (React + Vite)
# ===================================

# Dependencies
al-nour-frontend/node_modules/
al-nour-frontend/package-lock.json

# Build outputs
al-nour-frontend/dist/
al-nour-frontend/build/

# Environment variables
al-nour-frontend/.env
al-nour-frontend/.env.local
al-nour-frontend/.env.production
al-nour-frontend/.env.development

# Logs
al-nour-frontend/npm-debug.log*
al-nour-frontend/yarn-debug.log*
al-nour-frontend/yarn-error.log*
al-nour-frontend/pnpm-debug.log*
al-nour-frontend/lerna-debug.log*

# Editor directories and files
al-nour-frontend/.vscode/*
!al-nour-frontend/.vscode/extensions.json
al-nour-frontend/.idea
al-nour-frontend/.DS_Store
al-nour-frontend/*.suo
al-nour-frontend/*.ntvs*
al-nour-frontend/*.njsproj
al-nour-frontend/*.sln
al-nour-frontend/*.sw?

