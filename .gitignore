backend-files/storage/framework/cache/*
backend-files/storage/framework/sessions/*
backend-files/storage/framework/testing/*
backend-files/storage/framework/views/*
backend-files/storage/logs/*
backend-files/bootstrap/cache/*
backend-files/public/storage
backend-files/public/hot

# IDE
backend-files/.idea/
backend-files/.vscode/
backend-files/*.swp
backend-files/*.swo
backend-files/*~
backend-files/.DS_Store

# Composer
backend-files/composer.lock
backend-files/composer.phar

# PHPUnit
backend-files/.phpunit.result.cache
backend-files/phpunit.xml

# Laravel Mix
backend-files/public/css/
backend-files/public/js/
backend-files/public/mix-manifest.json

# NPM
backend-files/package-lock.json
backend-files/yarn.lock

